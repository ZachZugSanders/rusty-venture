# ── Rust ────────────────────────────────────────────────────────────────────
# Compiled output and Cargo build artefacts
debug/
target/

# rustfmt backup files
**/*.rs.bk

# MSVC debug info
*.pdb

# cargo-mutants output
**/mutants.out*/

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/
.env/

# pytest / coverage artefacts
.pytest_cache/
.coverage
htmlcov/

# Build / packaging artefacts
*.egg-info/
dist/          # generic Python sdist output (not the frontend dist/)
build/

# ── Frontend ─────────────────────────────────────────────────────────────────
# npm / yarn / pnpm / bun dependency trees — never commit these
frontend/node_modules/
# Built output — regenerated by CI, never commit
frontend/dist/

# Playwright browser binaries downloaded by pytest-playwright
playwright-report/
test-results/

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite databases created at runtime
*.db
*.db-shm
*.db-wal

# ── Editor / IDE ─────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Secrets ──────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Runtime / scratch ────────────────────────────────────────────────────────
server.log
server.err
test_request.json

# Debug screenshots dropped at the project root (e.g. by Playwright MCP)
/*.png

# ── Local tooling config ──────────────────────────────────────────────────────
.claude/settings.local.json

.playwright-mcp/*